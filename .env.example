# ====== Milvus ======
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=faq_collection
MILVUS_TIMEOUT=10

# ====== Embedding ======
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_DIM=768

# ====== LLM ======
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-actual-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ====== 业务数据 ======
# true=mock（开发期），false=调用真实业务 API
USE_MOCK_DATA=true

# ====== 业务 API（USE_MOCK_DATA=false 时生效）======
ORDER_API_BASE_URL=http://127.0.0.1:8002
ORDER_API_KEY=your-api-key-here
ORDER_API_TIMEOUT=10
ORDER_API_MAX_RETRIES=3

# ====== 检索参数 ======
VECTOR_TOP_K=8
BM25_TOP_K=8
FINAL_TOP_K=5
RRF_K=60
